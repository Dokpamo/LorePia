{
  "name": "@lorepia/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --port 5175 --open /preview.html",
    "tauri:demo": "tauri dev --config src-tauri/tauri.demo.conf.json",
    "dev:ui": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "tauri:ui": "tauri dev --config src-tauri/tauri.ui.conf.json",
    "build:ui": "vite build --mode ui",
    "tauri:ui:build": "tauri build --bundles app --config src-tauri/tauri.ui.conf.json",
    "tauri:ui:build:debug": "tauri build --debug --bundles app --config src-tauri/tauri.ui.conf.json",
    "tauri": "tauri",
    "build": "vite build",
    "format:check": "prettier --check .",
    "i18n:check": "python3 ../../scripts/check_i18n_literal_baseline.py",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:native && npm run typecheck:svelte",
    "typecheck:native": "tsc --project ./tsconfig.json",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check": "npm run format:check && npm run i18n:check && npm run lint && npm run typecheck",
    "test": "vitest run",
    "posttest": "node ../../scripts/test_portable_lua_sandbox.mjs && node ../../scripts/test_portable_regex_worker.mjs && node ../../scripts/test_markdown_retention.mjs",
    "test:component": "vitest run src/features",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/svelte": "1.33.0",
    "@tauri-apps/api": "2.11.1",
    "svelte": "5.56.10",
    "wasmoon": "1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  }
}
