{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LorePia",
  "version": "../package.json",
  "identifier": "dev.lorepia.app",
  "mainBinaryName": "lorepia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LorePia",
        "width": 1180,
        "height": 760,
        "minWidth": 248,
        "minHeight": 552,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 15,
          "y": 25
        },
        "transparent": false,
        "fullscreen": false,
        "visible": true,
        "devtools": false
      }
    ],
    "security": {
      "capabilities": ["main-development"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: lorepia-asset: http://lorepia-asset.localhost https://lorepia-asset.localhost",
        "media-src": "'self' blob: lorepia-asset: http://lorepia-asset.localhost https://lorepia-asset.localhost",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'self'",
        "frame-ancestors": "'none'",
        "worker-src": "'self'"
      },
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}
