{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5175 --mode demo",
    "devUrl": "http://127.0.0.1:5175/preview.html"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LorePia · Demo",
        "width": 1180,
        "height": 760,
        "minWidth": 248,
        "minHeight": 552,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 15,
          "y": 25
        },
        "transparent": false,
        "fullscreen": false,
        "visible": true,
        "devtools": false
      }
    ]
  }
}
