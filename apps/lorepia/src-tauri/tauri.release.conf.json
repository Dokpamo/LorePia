{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LorePia",
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LorePia",
        "width": 1180,
        "height": 760,
        "minWidth": 248,
        "minHeight": 552,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 15,
          "y": 25
        },
        "transparent": false,
        "fullscreen": false,
        "visible": true,
        "devtools": false
      }
    ],
    "security": {
      "capabilities": ["main-release"]
    }
  }
}
