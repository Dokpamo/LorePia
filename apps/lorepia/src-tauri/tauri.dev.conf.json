{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LorePia Dev",
  "identifier": "dev.lorepia.app.dev",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LorePia Dev",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "visible": true,
        "devtools": true
      }
    ],
    "security": {
      "capabilities": ["main-development"],
      "csp": {
        "connect-src": "ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173"
      }
    }
  }
}
