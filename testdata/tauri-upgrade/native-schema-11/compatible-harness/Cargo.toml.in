[package]
name = "lorepia-schema11-compatible-rollback-harness"
version = "0.1.0"
edition = "2024"
publish = false

[workspace]

[dependencies]
lorepia-shell-api = { path = "@LOREPIA_SHELL_API_PATH@" }
serde_json = "1.0"
sha2 = "0.10"

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
missing_errors_doc = "allow"
module_name_repetitions = "allow"
must_use_candidate = "allow"
