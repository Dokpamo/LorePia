[package]
name = "lorepia-schema11-runtime-harness"
version = "0.1.0"
edition = "2024"
publish = false

[workspace]

[dependencies]
chrono = { version = "0.4", features = ["serde"] }
getrandom = "0.4.3"
lorepia-core = { path = "@LOREPIA_CORE_PATH@" }
serde_json = "1.0"
sha2 = "0.10"
zeroize = "1.9.0"

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
missing_errors_doc = "allow"
module_name_repetitions = "allow"
must_use_candidate = "allow"
needless_pass_by_value = "allow"
